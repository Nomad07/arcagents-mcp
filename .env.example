# Arc Agents MCP configuration (example only: never commit a real .env)
#
# MCP clients normally pass these through the "env" block of their server
# configuration (see README.md). This file documents the available variables
# and can be used for local runs: export them in your shell first.

# REQUIRED. Private key (0x + 64 hex characters) of a DEDICATED wallet that holds
# a small USDC balance on the payment network. Never use your main wallet.
EVM_PRIVATE_KEY=

# Preferred payment network: arc (default) or base. Exactly one is used per run;
# the server never switches networks after a failed payment.
ARCAGENTS_PAYMENT_NETWORK=arc

# Maximum number of payments this server process may sign (1-1000, default 50).
# At $0.002 per request the default caps a session at $0.10.
ARCAGENTS_MAX_PAYMENTS=50

# Total timeout for one tool call, in milliseconds (1000-120000, default 30000).
ARCAGENTS_TIMEOUT_MS=30000

# Directory where signed but unresolved payments are saved (private to your user)
# so they are resent, never replaced, after a restart. Default: ~/.arcagents-mcp
# (under your user profile on Windows). A custom value MUST be an absolute path (a relative
# path or "~" is rejected at startup) and readable only by you; on Windows that needs a
# restrictive ACL.
# ARCAGENTS_STATE_DIR=
